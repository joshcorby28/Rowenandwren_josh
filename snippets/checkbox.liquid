{% style %}
.checkbox__icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 15px;
  height: 15px;
  margin-right: 10px;
  background-color: #f0f0f0;
  border: 1px solid #f0f0f0;
  border-radius: 50%;
  transition: background-color 0.2s ease,
              border-color 0.2s ease;
}

.checkbox__icon::after {
  content: "";
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
  border-radius: inherit;
  opacity: 0;
  backface-visibility: hidden;
  will-change: transform;
  transform: scale(0.61538);
  transform-origin: center;
  transition: opacity 0.2s ease,
              transform 0.2s ease;
}

.checkbox__input:hover ~ .checkbox__label .checkbox__icon,
.checkbox__input:focus ~ .checkbox__label .checkbox__icon,
.checkbox__input:focus-visible ~ .checkbox__label .checkbox__icon {
  border-color: #717171;
}

.checkbox__input:checked ~ .checkbox__label .checkbox__icon {
  background-color: #f0f0f0;
  border-color: #717171;
}

.checkbox__input:checked ~ .checkbox__label .checkbox__icon::after {
  background-color: #717171;
  opacity: 1;
}

ul.facets__inputs-list {
  grid-template-columns: repeat(2, 1fr);
  display: grid !important;
  gap: 20px;
}
{% endstyle %}


{%- doc -%}
  Renders a checkbox input and label

  @param {string} id - input id attribute
  @param {string} name - input name attribute
  @param {string} value - input value attribute
  @param {string} label - label text
  @param {boolean} checked - whether the input is checked
  @param {string} events - event attributes for the input, e.g. 'on:click="/action"'
  @param {boolean} disabled - whether the input is disabled
  @param {boolean} [required] - whether the input is required
  @param {string} [formId] - form id attribute for the input
  @param {string} [inputRef] - input ref attribute for use with component framework
  @param {string} [labelRef] - label ref attribute for use with component framework
  @param {boolean} [autofocus] - whether the input should be autofocused
{%- enddoc -%}
<div
  class="checkbox{% if disabled %} checkbox--disabled{% endif %}"
  {{ events }}
>
  <input
    type="checkbox"
    name="{{ name }}"
    value="{{ value }}"
    id="{{ id }}"
    class="checkbox__input"
    data-label="{{ label }}"
    {% if checked %}
      checked
    {% endif %}
    {% if disabled %}
      disabled
    {% endif %}
    {% if required %}
      required aria-required="true"
    {% endif %}
    {% if formId != blank %}
      form="{{ formId }}"
    {% endif %}
    {% if inputRef != blank %}
      ref="{{ inputRef }}"
    {% endif %}
    {% if autofocus %}
      autofocus
    {% endif %}
  >
  <label
    class="checkbox__label"
    for="{{ id }}"
    {% if labelRef != blank %}
      ref="{{ labelRef }}"
    {% endif %}
  >
    <div class="checkbox__icon"></div>
    <span class="checkbox__label-text">{{- label -}}</span>
  </label>
</div>
