{%- doc -%}
  Product title block with per-variant override support.

  Renders the product's <h1> title, but if the product has more than one variant
  AND the currently selected / first-available variant has a non-blank
  `custom.product_title_override` metafield, that value is rendered instead.

  Mirrors the behaviour of the previous theme's product / product-alternate
  sections. Because the product-information section re-renders on variant change,
  the title updates automatically when a different variant is selected.
{%- enddoc -%}

{% liquid
  assign product_resource = closest.product
%}

{% if product_resource == blank %}
  {% assign text = 'placeholders.product_title' | t %}
  {% assign product_title = '<h1>' | append: text | append: '</h1>' %}
  {% render 'text', fallback_text: product_title, block: block %}
{% else %}
  {% liquid
    assign override = product_resource.selected_or_first_available_variant.metafields.custom.product_title_override
    assign resolved_title = product_resource.title

    if product_resource.variants.size > 1 and override.value != blank
      assign resolved_title = override.value
    endif

    assign product_title = '<h1>' | append: resolved_title | append: '</h1>'
  %}
  {% render 'text', fallback_text: product_title, block: block %}
{% endif %}

