{%- comment -%}
  Self-contained product tab panels: markup, styles and behaviour all live
  in this snippet so it can be dropped into a template without relying on
  layout.theme.css.liquid or the tab-panels.chunk.*.js bundle.
{%- endcomment -%}

<style>
  .tbp-TabPanel { margin-bottom: 25px; }
  .tbp-TabPanel a { 
    text-decoration: none;
    font-weight: 500;
  }
  .tbp-TabPanel .prd-DetailContent_Features {
    --features-gutter: 5px;
    margin-top: 25px;
    padding: 0;
    list-style-type: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-right: calc(var(--features-gutter) * -1);
    margin-left: calc(var(--features-gutter) * -1);
    -webkit-user-select: none;
    user-select: none;
  }
  .tbp-TabPanel .prd-DetailContent_Feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    width: auto;
    margin: 0 var(--features-gutter);
    text-align: center;
  }
  .tbp-TabPanel .prd-DetailContent_FeatureIcon {
    width: 20px;
    margin-bottom: calc(var(--features-gutter) * 2);
  }
  .tbp-TabPanel .prd-DetailContent_FeatureIcon svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .tbp-TabPanel .prd-DetailContent_FeatureImage { object-fit: contain; }

  .tbp-TabPanel_TabList { display: flex; margin-bottom: 15px; list-style: none; padding: 0; gap: 20px; }
  .tbp-TabPanel_Tab { font-weight: 400; border: 0; background: transparent; }
  .tbp-TabPanel_Tab + .tbp-TabPanel_Tab { margin-left: calc(var(--grid__gutter) * 4); }

  .tbp-TabPanel_TabButton {
    position: relative;
    letter-spacing: 0.0625rem;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color__brand);
    gap: 20px;
  }
  .tbp-TabPanel_Tab .link { position: relative; }
  .tbp-TabPanel_Tab .link:after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    height: 1px;
    background-color: currentColor;
    backface-visibility: hidden;
    will-change: transform;
    transform: scale(0);
    transform-origin: 100% 0;
    transition: transform 0.5s ease;
  }
  .tbp-TabPanel_Tab .link:hover:after,
  .tbp-TabPanel_Tab .link[aria-selected="true"]:after {
    transform: scale(1);
    transform-origin: 0 0;
  }

  .tbp-TabPanel_Panel { display: none; }
  .tbp-TabPanel_Panel-active { display: block; }

  @media (min-width: 768px) {
    .tbp-TabPanel { margin-bottom: 35px; }
    .tbp-TabPanel .prd-DetailContent_Features { margin-top: 35px; }
    .tbp-TabPanel .prd-DetailContent_Feature {
      flex-direction: row;
      width: 25%;
      margin: 0 0 10px 0;
      padding-left: 0;
      text-align: left;
    }
    .tbp-TabPanel .prd-DetailContent_Feature:before { display: none; }
    .tbp-TabPanel .prd-DetailContent_FeatureIcon {
      width: 20px;
      margin: 0 calc(var(--features-gutter) * 2) 0 0;
    }
    .tbp-TabPanel_TabList { margin-bottom: 25px; }
  }

  .tbp-TabPanel_Tab .link {
    background: transparent;
    border: 0;
    outline: 0;
    color: #717171;
    font-family: var(--font-paragraph--family);
    cursor: pointer;
    padding: 5px 0 0;
  }
</style>

{%- liquid
  assign tabs = 'notes,details-and-dimensions,delivery-and-returns'

  if product.description == blank
    assign tabs = tabs | remove_first: 'notes,'
  endif

  if product.metafields.details.details_and_dimensions == blank
    assign tabs = tabs | remove_first: 'details-and-dimensions,'
  endif

  assign tabs = tabs | split: ','
-%}

<div class="tbp-TabPanel" data-module="tab-panels">
  <ul class="tbp-TabPanel_TabList" role="tablist" aria-label="Tabs">
    {%- for tab in tabs -%}
      <li class="tbp-TabPanel_Tab">
        <button
          class="link"
          data-id="{{ tab }}"
          data-el="tab-panels.tab"
          aria-selected="{{ forloop.first | json }}"
          role="tab"
        >
          {{ 'products.tabs.' | append: tab | replace: '-', '_' | t }}
        </button>
      </li>
    {%- endfor -%}
  </ul>

  <div class="tbp-TabPanel_Panels">
    {%- for tab in tabs -%}
      <div
        class="tbp-TabPanel_Panel {%- if forloop.first %} tbp-TabPanel_Panel-active {% endif %} rte-RichText"
        data-id="{{ tab }}"
        data-el="tab-panels.panel"
        aria-labelledby="{{ tab }}"
        role="tabpanel"
      >
        {%- if tab == 'notes' -%}
          {% if product.type == 'Upholstery' %}
              {% if product.tags contains 'Available Now' %}
                 <p><strong>Available Now</strong><br>
              Handcrafted and ready to deliver within 7–10 working days</p>

            {% endif %}
          {% else %}
          {% endif %}
          {{ product.description | replace: "—", "-" | replace: "–", "-" }}

          {%- render 'product-features-list', product: product -%}

        {%- elsif tab == 'details-and-dimensions' -%}
             {% if product.metafields.custom.details_dimensions_tab != blank %}
              {{ product.metafields.custom.details_dimensions_tab }}
            {% else %}
              {{ product.metafields.details.details_and_dimensions.html }}
            {% endif %}
            {% if localization.country.iso_code == 'US' and product.metafields.custom.prop-65 != blank -%}
                <p>{{ product.metafields.custom.prop-65 | metafield_tag }} </p>
            {%- else -%}
            {%- endif -%}
        {%- else -%}
          {% if product.tags contains 'MK-SKU' %}
            {% if product.type == 'Upholstery' %}
                {% if product.tags contains 'Available Now' %}
                  <p>LARGE ITEM DELIVERY<br><br>Delivery costs £48 within the UK and will be made by our two-person team within 7-10 working days. Our customer care team will pass on your order details to our courier partners who will then be in touch to arrange a convenient time for your delivery.<br><br>For full delivery details, including international delivery, <a href="https://www.rowenandwren.co.uk/pages/delivery">click here</a>.<br><br>RETURNS<br><br>Know that if it is not meant to be, returning your piece/s to us shall be a simple affair. To be mindful of our carbon footprint, we have an online returns process. For full details, <a href="https://www.rowenandwren.co.uk/pages/returns">click here</a>.</p>
                {% else %}
                  <p>LARGE ITEM DELIVERY<br><br>Delivery costs £48 within the UK and will be made by our two-person team within 7-10 working days. For upholstered pieces such as this, note that they are handmade to order and will take {% if product.title contains 'Bed' or product.title contains 'Sofa' or product.title contains 'Armchair' or product.title contains 'Chair' or product.title contains 'Valance' or product.title contains 'Headboard'%}6-8.  weeks{% else %}4-6 weeks{% endif %} (less wherever we can) to arrive in your home. Our customer care team will pass on your order details to our courier partners who will then be in touch to arrange a convenient time for your delivery.<br><br>For full delivery details, including international delivery, <a href="https://www.rowenandwren.co.uk/pages/delivery">click here</a>.<br><br>RETURNS<br><br>Know that if it is not meant to be, returning your piece/s to us shall be a simple affair. To be mindful of our carbon footprint, we have an online returns process. For full details, <a href="https://www.rowenandwren.co.uk/pages/returns">click here</a>.</p>
                {% endif %}
            {% else %}
            <p>LARGE ITEM DELIVERY<br><br>Delivery costs £48 within the UK and will be made by our two-person team within 7-10 working days. Our customer care team will pass on your order details to our courier partners who will then be in touch to arrange a convenient time for your delivery.<br><br>For full delivery details, including international delivery, <a href="https://www.rowenandwren.co.uk/pages/delivery">click here</a>.<br><br>RETURNS<br><br>Know that if it is not meant to be, returning your piece/s to us shall be a simple affair. To be mindful of our carbon footprint, we have an online returns process. For full details, <a href="https://www.rowenandwren.co.uk/pages/returns">click here</a>.</p>
            {% endif %}
        {% else %}
          <p>POSTAL DELIVERY<br><br>We have two delivery options. 'Standard' costs £6 and shall be with you in just 2-3 working days. 'Express' costs £9 and will be with you on the next working day if you order before 2pm (unless on pre-order). Simply pick your preferred option at checkout.<br><br>For full delivery details, including international delivery, <a href="https://www.rowenandwren.co.uk/pages/delivery">click here</a>.<br><br>RETURNS<br><br>Know that if it is not meant to be, returning your piece/s to us shall be a simple affair. To be mindful of our carbon footprint, we have an online returns process. For full details, <a href="https://www.rowenandwren.co.uk/pages/returns">click here</a>.</p>
        {% endif %}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    if (window.__tbpTabPanelsInit) return;
    window.__tbpTabPanelsInit = true;

    var ACTIVE_CLASS = 'tbp-TabPanel_Panel-active';

    function init(root) {
      var tabs = Array.prototype.slice.call(
        root.querySelectorAll('[data-el="tab-panels.tab"]')
      );
      var panels = Array.prototype.slice.call(
        root.querySelectorAll('[data-el="tab-panels.panel"]')
      );
      if (!tabs.length) return;

      function activate(tab) {
        tabs.forEach(function (t) {
          var isActive = t === tab;
          t.setAttribute('aria-selected', isActive);
          var panel = panels.filter(function (p) {
            return p.dataset.id === t.dataset.id;
          })[0];
          if (panel) panel.classList.toggle(ACTIVE_CLASS, isActive);
        });
      }

      tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () { activate(tab); });

        tab.addEventListener('keydown', function (e) {
          var last = tabs.length - 1;
          var target = null;
          switch (e.key) {
            case 'ArrowRight':
            case 'ArrowDown':
              target = tabs[index === last ? 0 : index + 1];
              break;
            case 'ArrowLeft':
            case 'ArrowUp':
              target = tabs[index === 0 ? last : index - 1];
              break;
            case 'Home':
              target = tabs[0];
              break;
            case 'End':
              target = tabs[last];
              break;
          }
          if (target) {
            e.preventDefault();
            target.focus();
          }
        });
      });
    }

    function bootstrap() {
      var roots = document.querySelectorAll('[data-module="tab-panels"]');
      Array.prototype.forEach.call(roots, init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap);
    } else {
      bootstrap();
    }
  })();
</script>

{% schema %}
{
  "name": "Product tabs",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Tabs",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}


