{{ 'customer-account.css' | asset_url | stylesheet_tag }}

<section
  class="customer-account-section"
  data-customer-account-section
  {{ section.shopify_attributes }}
>
  <select class="customer-account__hidden" data-country-options tabindex="-1" aria-hidden="true">{{ country_option_tags }}</select>

  <template data-header-image>
    {%- if section.settings.header_image != blank -%}
      {{
        section.settings.header_image
        | image_url: width: 1920
        | image_tag:
          class: 'customer-account__hero-image',
          loading: 'lazy',
          widths: '900, 1200, 1440, 1920',
          sizes: '100vw'
      }}
    {%- endif -%}
  </template>

  <template data-login-image>
    {%- if section.settings.login_image != blank -%}
      {{
        section.settings.login_image
        | image_url: width: 1200
        | image_tag:
          class: 'customer-account__aside-image',
          loading: 'lazy',
          widths: '540, 720, 900, 1200',
          sizes: '(min-width: 901px) 50vw, 100vw'
      }}
    {%- elsif section.settings.header_image != blank -%}
      {{
        section.settings.header_image
        | image_url: width: 1200
        | image_tag:
          class: 'customer-account__aside-image',
          loading: 'lazy',
          widths: '540, 720, 900, 1200',
          sizes: '(min-width: 901px) 50vw, 100vw'
      }}
    {%- endif -%}
  </template>

  <template data-welcome-image>
    {%- if section.settings.welcome_image != blank -%}
      {{
        section.settings.welcome_image
        | image_url: width: 900
        | image_tag:
          class: 'customer-account__welcome-image',
          loading: 'lazy',
          widths: '450, 600, 750, 900',
          sizes: '(min-width: 901px) 40vw, 100vw'
      }}
    {%- elsif section.settings.login_image != blank -%}
      {{
        section.settings.login_image
        | image_url: width: 900
        | image_tag:
          class: 'customer-account__welcome-image',
          loading: 'lazy',
          widths: '450, 600, 750, 900',
          sizes: '(min-width: 901px) 40vw, 100vw'
      }}
    {%- endif -%}
  </template>

  <template data-seasonal-stories>
    {%- if section.settings.show_seasonal_stories -%}
      <div class="customer-account__seasonal">
        <div class="customer-account__inner">
          <h2 class="customer-account__seasonal-title">{{ section.settings.seasonal_stories_title | default: 'Seasonal Stories' }}</h2>
          <div class="customer-account__seasonal-grid">
            {%- if section.settings.story_1_image != blank -%}
              <article class="customer-account__story">
                <a href="{{ section.settings.story_1_link | default: '#' }}" class="customer-account__story-link">
                  {{
                    section.settings.story_1_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'customer-account__story-image',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 901px) 40vw, 100vw'
                  }}
                  <div class="customer-account__story-caption">
                    <p class="customer-account__story-title">{{ section.settings.story_1_title }}</p>
                    {%- if section.settings.story_1_link_label != blank -%}
                      <span class="customer-account__link">{{ section.settings.story_1_link_label }}</span>
                    {%- endif -%}
                  </div>
                </a>
              </article>
            {%- endif -%}
            {%- if section.settings.story_2_image != blank -%}
              <article class="customer-account__story">
                <a href="{{ section.settings.story_2_link | default: '#' }}" class="customer-account__story-link">
                  {{
                    section.settings.story_2_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'customer-account__story-image',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 901px) 40vw, 100vw'
                  }}
                  <div class="customer-account__story-caption">
                    <p class="customer-account__story-title">{{ section.settings.story_2_title }}</p>
                    {%- if section.settings.story_2_link_label != blank -%}
                      <span class="customer-account__link">{{ section.settings.story_2_link_label }}</span>
                    {%- endif -%}
                  </div>
                </a>
              </article>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </template>

  <div data-customer-account-app></div>

  {%- liquid
    # OAuth requires an absolute redirect_uri that matches the Headless allowlist
    # exactly. The account page setting stores a relative path, so qualify it.
    assign account_redirect = settings.customer_account_page | default: page.url
    unless account_redirect contains '://'
      assign account_redirect = request.origin | append: account_redirect
    endunless
  -%}

  <script type="application/json" data-customer-account-config>
    {
      "clientId": {{ settings.customer_account_client_id | json }},
      "redirectUri": {{ account_redirect | json }},
      "shopDomain": {{ shop.permanent_domain | json }},
      "mockMode": {{ section.settings.use_mock_data | json }},
      "content": {
        "returnsUrl": {{ section.settings.returns_url | default: "https://www.rowenandwren.co.uk/a/returns" | json }},
        "collectionUrl": {{ section.settings.collection_url | default: "/collections/all" | json }},
        "welcomeEyebrow": {{ section.settings.welcome_eyebrow | default: "A few new additions" | json }},
        "welcomeHeading": {{ section.settings.welcome_heading | default: "Welcome Back" | json }},
        "welcomeBody": {{ section.settings.welcome_body | default: "It's good to see you again. You'll notice a few new things since your last visit. Pieces made to be used, lived with, and gathered around. Take a look around when it suits." | json }},
        "welcomeCta": {{ section.settings.welcome_cta_label | default: "Peruse our current collection" | json }}
      },
      "strings": {
        "loading": {{ 'customer_account.loading' | t | json }},
        "try_again": {{ 'customer_account.try_again' | t | json }},
        "error_generic": {{ 'customer_account.error_generic' | t | json }},
        "error_discovery": {{ 'customer_account.error_discovery' | t | json }},
        "error_auth_state": {{ 'customer_account.error_auth_state' | t | json }},
        "error_auth_token": {{ 'customer_account.error_auth_token' | t | json }},
        "error_client_id": {{ 'customer_account.error_client_id' | t | json }},
        "error_unauthenticated": {{ 'customer_account.error_unauthenticated' | t | json }},
        "error_session_expired": {{ 'customer_account.error_session_expired' | t | json }},
        "account_title": {{ 'content.account_title' | t | json }},
        "sign_in": {{ 'customer_account.sign_in' | t | json }},
        "sign_in_description": {{ 'customer_account.sign_in_description' | t | json }},
        "email_address": {{ 'customer_account.email_address' | t | json }},
        "password": {{ 'customer_account.password' | t | json }},
        "forgotten_password": {{ 'customer_account.forgotten_password' | t | json }},
        "new_user": {{ 'customer_account.new_user' | t | json }},
        "join_us": {{ 'customer_account.join_us' | t | json }},
        "nav_welcome": {{ 'customer_account.nav_welcome' | t | json }},
        "nav_address_book": {{ 'customer_account.nav_address_book' | t | json }},
        "nav_orders": {{ 'customer_account.nav_orders' | t | json }},
        "nav_returns": {{ 'customer_account.nav_returns' | t | json }},
        "nav_logout": {{ 'customer_account.nav_logout' | t | json }},
        "welcome_hero": {{ 'customer_account.welcome_hero' | t | json }},
        "welcome_eyebrow": {{ 'customer_account.welcome_eyebrow' | t | json }},
        "welcome_heading": {{ 'customer_account.welcome_heading' | t | json }},
        "welcome_body": {{ 'customer_account.welcome_body' | t | json }},
        "welcome_cta": {{ 'customer_account.welcome_cta' | t | json }},
        "account_navigation": {{ 'customer_account.navigation' | t | json }},
        "addresses_hero": {{ 'customer_account.addresses_hero' | t | json }},
        "orders_hero": {{ 'customer_account.orders_hero' | t | json }},
        "add_new_address": {{ 'customer_account.add_new_address' | t | json }},
        "your_addresses": {{ 'customer_account.your_addresses' | t | json }},
        "set_default_address": {{ 'customer_account.set_default_address' | t | json }},
        "no_orders": {{ 'customer_account.no_orders' | t | json }},
        "order_not_found": {{ 'customer_account.order_not_found' | t | json }},
        "back_to_orders": {{ 'customer_account.back_to_orders' | t | json }},
        "payment_status": {{ 'customer_account.payment_status' | t | json }},
        "fulfillment_status": {{ 'customer_account.fulfillment_status' | t | json }},
        "items": {{ 'customer_account.items' | t | json }},
        "quantity": {{ 'accessibility.quantity' | t | json }},
        "subtotal": {{ 'content.cart_subtotal' | t | json }},
        "discounts": {{ 'content.discounts' | t | json }},
        "shipping": {{ 'customer_account.shipping' | t | json }},
        "tax": {{ 'customer_account.tax' | t | json }},
        "total": {{ 'content.cart_total' | t | json }},
        "shipping_address": {{ 'customer_account.shipping_address' | t | json }},
        "billing_address": {{ 'customer_account.billing_address' | t | json }},
        "not_available": {{ 'customer_account.not_available' | t | json }},
        "no_addresses": {{ 'customer_account.no_addresses' | t | json }},
        "add_address": {{ 'customer_account.add_address' | t | json }},
        "update_address": {{ 'customer_account.update_address' | t | json }},
        "default_address": {{ 'customer_account.default_address' | t | json }},
        "edit": {{ 'customer_account.edit' | t | json }},
        "delete": {{ 'actions.remove' | t | json }},
        "set_default": {{ 'customer_account.set_default' | t | json }},
        "confirm_delete_address": {{ 'customer_account.confirm_delete_address' | t | json }},
        "first_name": {{ 'customer_account.first_name' | t | json }},
        "last_name": {{ 'customer_account.last_name' | t | json }},
        "company": {{ 'customer_account.company' | t | json }},
        "address1": {{ 'customer_account.address1' | t | json }},
        "address2": {{ 'customer_account.address2' | t | json }},
        "city": {{ 'customer_account.city' | t | json }},
        "province": {{ 'customer_account.province' | t | json }},
        "postcode": {{ 'customer_account.postcode' | t | json }},
        "country": {{ 'customer_account.country' | t | json }},
        "phone": {{ 'customer_account.phone' | t | json }},
        "mock_mode_banner": {{ 'customer_account.mock_mode_banner' | t | json }},
        "mock_mode_guest_hint": {{ 'customer_account.mock_mode_guest_hint' | t | json }}
      }
    }
  </script>
</section>

<script src="{{ 'customer-account.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Customer account",
  "class": "section-customer-account",
  "settings": [
    {
      "type": "paragraph",
      "content": "Branded customer account powered by Shopify Customer Account API. Create a page with handle 'account' and assign this template."
    },
    {
      "type": "checkbox",
      "id": "use_mock_data",
      "label": "Use mock account data",
      "info": "Preview with sample data. No API credentials required. Turn off before publishing.",
      "default": false
    },
    {
      "type": "header",
      "content": "Hero & sign in"
    },
    {
      "type": "image_picker",
      "id": "header_image",
      "label": "Hero background image"
    },
    {
      "type": "image_picker",
      "id": "login_image",
      "label": "Sign-in side image"
    },
    {
      "type": "header",
      "content": "A Warm Welcome"
    },
    {
      "type": "text",
      "id": "welcome_eyebrow",
      "label": "Eyebrow text",
      "default": "A few new additions"
    },
    {
      "type": "text",
      "id": "welcome_heading",
      "label": "Heading",
      "default": "Welcome Back"
    },
    {
      "type": "textarea",
      "id": "welcome_body",
      "label": "Body text",
      "default": "It's good to see you again. You'll notice a few new things since your last visit. Pieces made to be used, lived with, and gathered around. Take a look around when it suits."
    },
    {
      "type": "text",
      "id": "welcome_cta_label",
      "label": "Collection link label",
      "default": "Peruse our current collection"
    },
    {
      "type": "url",
      "id": "collection_url",
      "label": "Collection link"
    },
    {
      "type": "image_picker",
      "id": "welcome_image",
      "label": "Welcome panel image"
    },
    {
      "type": "url",
      "id": "returns_url",
      "label": "Returns page URL",
      "default": "https://www.rowenandwren.co.uk/a/returns"
    },
    {
      "type": "header",
      "content": "Seasonal Stories"
    },
    {
      "type": "checkbox",
      "id": "show_seasonal_stories",
      "label": "Show Seasonal Stories",
      "default": true
    },
    {
      "type": "text",
      "id": "seasonal_stories_title",
      "label": "Section title",
      "default": "Seasonal Stories"
    },
    {
      "type": "image_picker",
      "id": "story_1_image",
      "label": "Story 1 image"
    },
    {
      "type": "text",
      "id": "story_1_title",
      "label": "Story 1 title",
      "default": "Our British Upholstery Collection"
    },
    {
      "type": "text",
      "id": "story_1_link_label",
      "label": "Story 1 link label",
      "default": "View Our Edit"
    },
    {
      "type": "url",
      "id": "story_1_link",
      "label": "Story 1 link"
    },
    {
      "type": "image_picker",
      "id": "story_2_image",
      "label": "Story 2 image"
    },
    {
      "type": "text",
      "id": "story_2_title",
      "label": "Story 2 title",
      "default": "Hardware"
    },
    {
      "type": "text",
      "id": "story_2_link_label",
      "label": "Story 2 link label",
      "default": "View Our Edit"
    },
    {
      "type": "url",
      "id": "story_2_link",
      "label": "Story 2 link"
    }
  ],
  "presets": [
    {
      "name": "Customer account"
    }
  ]
}
{% endschema %}
