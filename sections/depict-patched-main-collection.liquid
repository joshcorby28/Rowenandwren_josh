{% comment %}
  IMPORTANT: The contents of this file are auto-generated by Depict.

  This file is a patched version of the original resource located at 'sections/main-collection.liquid'.
  Any changes made directly to this file will eventually be overwritten.
  If you wish to make changes, you should instead edit the original 'sections/main-collection.liquid' file.
  This file will then be re-generated to include your changes.
{% endcomment %}
{% if request.design_mode %}
  <div class="depict-theme-editor-notice" role="status" style="position:fixed;top:0;left:0;right:0;z-index:2147483647;box-sizing:border-box;padding:12px 20px;background:#c62828;color:#fff;text-align:center;border-bottom:3px solid #8e1f1f;font:400 14px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;box-shadow:0 2px 12px rgba(0,0,0,.35);">
    <span style="max-width:820px;display:inline-block;">
      <strong style="display:block;font-size:15px;font-weight:700;margin-bottom:2px;">
        ⚠️ This page is managed by Depict's automatic theme patcher ⚠️
      </strong>
      Manual edits here will be overwritten when the original collection template
      (without “depict” in the name) changes. Edit the original template directly and
      your changes will be copied here.
      <span style="display:block;margin-top:4px;font-size:12px;opacity:.85;">
        Only you can see this notice. Your customers cannot.
      </span>
    </span>
  </div>
{% endif %}


<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>



{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;{% if section.settings.enable_mobile_padding %} --padding-block-start-mobile: {{ section.settings.padding-block-start-mobile }}px; --padding-block-end-mobile: {{ section.settings.padding-block-end-mobile }}px;{% endif %}"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {%- comment -%}
        Promo cards come from a per-collection metafield pointing at a list of
        `promo_card` metaobjects. Each entry has: position (integer, 1-indexed
        slot in the final interleaved grid), media_type, image, video, heading,
        text, link.

        Slot model: position N means "the Nth item in the final grid, counting
        both products and promos". So products[0] is slot 1 by default, but if
        a promo claims slot 1, products[0] gets shifted to slot 2.

        Pagination model: products are paginated by Shopify (24 per page), so
        page 2 always contains products 25–48 of the product list. Promos are
        layered on top — a promo at slot 5 appears on page 1, a promo at
        slot 30 appears wherever product #25 lands (which itself may have
        been shifted by earlier promos).

        Algorithm:
          1. Sort promos by position.
          2. Walk products on this page. Maintain `current_slot`, which is the
             slot the next item will occupy in the final grid. Initialise it
             to (offset + 1 + count of promos with position <= offset + count
             of promos already placed before the current product).
          3. Before each product, drain any promos whose position equals the
             current slot. Each drained promo advances current_slot by 1.
          4. After all products, drain any trailing promos that fall within
             this page's slot range.
      {%- endcomment -%}

      {%- assign promo_cards = collection.metafields.custom.promo_cards.value -%}

      {%- comment -%}
        If any storefront filter is active, suppress promo cards. Interleaving
        promos into a filtered subset of products produces a layout that's
        usually surprising for shoppers (the promos may dominate a small
        filtered result set). A filter is "active" if any of its values has
        active=true. This check is intentionally conservative; merchants who
        want promos in filtered views can revisit.
      {%- endcomment -%}
      {%- assign filters_active = false -%}
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          {%- assign filters_active = true -%}
          {%- break -%}
        {%- endfor -%}
        {%- if filters_active -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if filters_active -%}
        {%- assign promo_cards = '' | split: ',' -%}
      {%- endif -%}

      {%- assign sorted_promos = promo_cards | sort: 'position' -%}

      {%- comment -%}
        Find the starting slot for this page. The first product on this page
        is at slot (offset + 1 + promos_before_this_product), where
        promos_before_this_product is the count of promos whose position is
        less than or equal to (offset + that count). We iterate to converge,
        but in practice this is just "count promos with position <= the slot
        where product #(offset+1) ends up". A simple sweep handles it.
      {%- endcomment -%}
      {%- assign offset = paginate.current_offset -%}
      {%- assign promos_before_page = 0 -%}
      {%- assign slot_for_first_product = offset | plus: 1 -%}
      {%- for promo in sorted_promos -%}
        {%- if promo.position <= slot_for_first_product -%}
          {%- assign promos_before_page = promos_before_page | plus: 1 -%}
          {%- assign slot_for_first_product = offset | plus: 1 | plus: promos_before_page -%}
        {%- else -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}
        page_last_slot is exclusive of promos that haven't been counted yet,
        but inclusive of all items rendered on this page. We compute it after
        the loop by tracking current_slot. For the bounds check, we use a
        conservative upper bound: the last product's slot plus the number of
        promos remaining at positions within reach.
      {%- endcomment -%}

      {% capture children %}
        {%- comment -%}
          On page 1, current_slot starts at 1 and we render any leading
          promos (positions 1..N before the first product) inline below.
          On later pages, current_slot starts at slot_for_first_product,
          which accounts for promos already rendered on prior pages.
        {%- endcomment -%}
        {%- if paginate.current_page == 1 -%}
          {%- assign current_slot = 1 -%}
        {%- else -%}
          {%- assign current_slot = slot_for_first_product -%}
        {%- endif -%}

        {%- comment -%}
          Render leading promos on page 1 only: those at positions before
          the first product. On later pages these were rendered on prior
          pages and slot_for_first_product already reflects them.
        {%- endcomment -%}
        {%- if paginate.current_page == 1 -%}
          {%- for promo in sorted_promos limit: promos_before_page -%}
            <li
              id="{{ section.id }}-promo-{{ promo.id }}"
              class="product-grid__item product-grid__item--promo product-grid__item--{{ current_slot | minus: 1 }}"
              data-page="{{ paginate.current_page }}"
              data-promo-position="{{ promo.position }}"
              ref="cards[]"
            >
              {% render 'product-grid-promo-card', promo: promo %}
            </li>
            {%- assign current_slot = current_slot | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}

        {%- assign promo_index = promos_before_page -%}

        <depict-grid-start-beacon 
        {% liquid
        comment
            set the defaults that would happen if someone just looped over collection.products with a for loop without pagination
        endcomment

        assign depict_page_size = "50"
        if paginate.page_size
            assign depict_page_size = paginate.page_size
        endif

        assign depict_pagination_pages = "1"
        if paginate.pages
            assign depict_pagination_pages = paginate.pages
        endif

        assign depict_current_page = "0"
        if paginate.current_page
            comment
            make depict_current_page 0-indexed because that makes it much easier in the typescript side
            endcomment
            assign depict_current_page = paginate.current_page | minus: 1
        endif
        %}
        style="display:none;"
        data-paginate='
            {
            "page_size": {{ depict_page_size }},
            "pages": {{ depict_pagination_pages }},
            "current_page": {{ depict_current_page }}
            }
        '></depict-grid-start-beacon>
        {% for product in collection.products %}
          {%- comment -%}
            Drain promos that belong at this slot. Loop handles consecutive
            promos at positions current_slot, current_slot+1, etc.
          {%- endcomment -%}
          {%- for promo in sorted_promos offset: promo_index -%}
            {%- if promo.position <= current_slot -%}
              <li
                id="{{ section.id }}-promo-{{ promo.id }}"
                class="product-grid__item product-grid__item--promo product-grid__item--{{ current_slot | minus: 1 }}"
                data-page="{{ paginate.current_page }}"
                data-promo-position="{{ promo.position }}"
                ref="cards[]"
              >
                {% render 'product-grid-promo-card', promo: promo %}
              </li>
              {%- assign promo_index = promo_index | plus: 1 -%}
              {%- assign current_slot = current_slot | plus: 1 -%}
            {%- else -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ current_slot | minus: 1 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: 'depict-patched-_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
          </li>
          {%- assign current_slot = current_slot | plus: 1 -%}
        {% endfor %}
        <depict-grid-end-beacon style="display:none;"></depict-grid-end-beacon>

        {%- comment -%}
          Trailing promos: on the final page, render any remaining promos
          whose position falls at or before current_slot. On non-final pages,
          we don't render trailing promos — they'll appear on the next page
          before the next product. The "last page" check uses paginate.next
          which is nil on the final page.
        {%- endcomment -%}
        {%- if paginate.next == nil or paginate.next.is_link == false -%}
          {%- for promo in sorted_promos offset: promo_index -%}
            <li
              id="{{ section.id }}-promo-{{ promo.id }}"
              class="product-grid__item product-grid__item--promo product-grid__item--{{ current_slot | minus: 1 }}"
              data-page="{{ paginate.current_page }}"
              data-promo-position="{{ promo.position }}"
              ref="cards[]"
            >
              {% render 'product-grid-promo-card', promo: promo %}
            </li>
            {%- assign current_slot = current_slot | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll,
        promo_cards: promo_cards
      %}
    {% endpaginate %}
  </div>
</results-list>

{% stylesheet %}  .main-collection-grid {
    grid-column: var(--grid-column--mobile);

    @media screen and (min-width: 750px) {
      grid-column: var(--grid-column--desktop);
    }
  }{% endstylesheet %}
{% javascript %}  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }{% endjavascript %}
{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "alternating",
          "label": "Alternating"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_padding",
      "label": "t:settings.enable_mobile_padding",
      "info": "t:info.enable_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    }
  ],
  "presets": []
}
{% endschema %}
