<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      color-{{ section.settings.color_scheme }}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}
    <div
      ref="grid"
      class="blog-posts-container"
    >
      {% for article in blog.articles %}
        {%- assign cycle_pos = forloop.index | modulo: 7 -%}

        <div
          class="blog-post-item{% if cycle_pos == 5 or cycle_pos == 6 or cycle_pos == 0 %} blog-post-item--wide{% endif %}"
          data-testid="blog-post-item"
        >
          {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
        </div>
      {% endfor %}
    </div>
  </div>
</blog-posts-list>

{% stylesheet %}
/**
 * Blog posts page layout
 */
.blog-posts {
  --page-content-width: var(--narrow-page-width);
  --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
  --columns-gap: 36px;
  --rows-gap: 36px;
}

.blog-posts-container {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  width: 100%;
  column-gap: 10px;
  row-gap: 35px;
}

/**
 * Blog post grid layout: repeating 4-per-row, 3-per-row pattern.
 * Uses a 7-item cycle on a 12-column grid:
 *   - Items 1–4 in each cycle: span 3 cols (4 posts per row)
 *   - Items 5–7 in each cycle: span 4 cols (3 posts per row)
 */
.blog-post-item {
  grid-column: span 3;
}

.blog-post-item--wide {
  grid-column: span 4;
}

/**
 * Tablet: force all items to 3 per row (span 4 of 12).
 */
@media screen and (min-width: 750px) and (max-width: 1200px) {
  .blog-post-item {
    grid-column: span 4;
  }
}

/**
 * Mobile: 1 per row.
 */
@media screen and (max-width: 749px) {
  .blog-post-item {
    grid-column: span 12;
  }
}

/**
 * When there's no image, the blog post item has a border.
 */
.blog-post-item {
  border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
  padding: 0 1rem 1rem;
}

.blog-post-item:has(.blog-post-card__image-container) {
  border: none;
  padding: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "text" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "button" },
    { "type": "video" },
    { "type": "group" },
    { "type": "spacer" },
    { "type": "_divider" }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_padding",
      "label": "t:settings.enable_mobile_padding",
      "info": "t:info.enable_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    }
  ]
}
{% endschema %}